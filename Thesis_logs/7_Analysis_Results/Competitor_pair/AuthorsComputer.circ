    <comp lib="9" loc="(3850,1400)" name="Text">
      <a name="font" val="SansSerif plain 14"/>
      <a name="halign" val="left"/>
      <a name="text" val="SETUP (automatic ticks OFF)"/>
    </comp>
    <comp lib="9" loc="(3850,1430)" name="Text">
      <a name="font" val="SansSerif plain 14"/>
      <a name="halign" val="left"/>
      <a name="text" val="1. Load ROM; choose STOP_ADDRESS and STOP_ENABLE."/>
    </comp>
    <comp lib="9" loc="(3850,1460)" name="Text">
      <a name="font" val="SansSerif plain 14"/>
      <a name="halign" val="left"/>
      <a name="text" val="2. reset = 1; advance one full clock cycle; reset = 0."/>
    </comp>
    <comp lib="9" loc="(3850,1490)" name="Text">
      <a name="font" val="SansSerif plain 14"/>
      <a name="halign" val="left"/>
      <a name="text" val="3. STAT_RESET = 1, then 0. Set MEASURE = 1."/>
    </comp>
    <comp lib="9" loc="(3850,1520)" name="Text">
      <a name="font" val="SansSerif plain 14"/>
      <a name="halign" val="left"/>
      <a name="text" val="4. Run. HALTED = 1 freezes CPU state and statistics."/>
    </comp>
    <comp lib="9" loc="(3850,1550)" name="Text">
      <a name="font" val="SansSerif plain 14"/>
      <a name="halign" val="left"/>
      <a name="text" val="To restart: stop automatic ticks and repeat steps 2-3."/>
    </comp>
    <comp lib="9" loc="(3850,1610)" name="Text">
      <a name="font" val="SansSerif plain 14"/>
      <a name="halign" val="left"/>
      <a name="text" val="Reads: C-instructions selecting M; instruction fetches excluded."/>
    </comp>
    <comp lib="9" loc="(3850,1640)" name="Text">
      <a name="font" val="SansSerif plain 14"/>
      <a name="halign" val="left"/>
      <a name="text" val="Writes: RAM write operations. Jumps: taken jumps."/>
    </comp>
    <comp lib="9" loc="(3850,1670)" name="Text">
      <a name="font" val="SansSerif plain 14"/>
      <a name="halign" val="left"/>
      <a name="text" val="Single-cycle CPU: Cycles = Instructions."/>
    </comp>
    <comp lib="9" loc="(3850,1700)" name="Text">
      <a name="font" val="SansSerif plain 14"/>
      <a name="halign" val="left"/>
      <a name="text" val="32-bit counters wrap at 2^32."/>
    </comp>
    <comp lib="9" loc="(3850,870)" name="Text">
      <a name="font" val="SansSerif plain 20"/>
      <a name="halign" val="left"/>
      <a name="text" val="1. STATISTICS"/>
    </comp>
    <comp lib="9" loc="(5240,1550)" name="Text">
      <a name="font" val="SansSerif plain 14"/>
      <a name="halign" val="left"/>
      <a name="text" val="STOP_ADDRESS: first address NOT executed."/>
    </comp>
    <comp lib="9" loc="(5240,1590)" name="Text">
      <a name="font" val="SansSerif plain 14"/>
      <a name="halign" val="left"/>
      <a name="text" val="HEX example: decimal 20 = 0014."/>
    </comp>
    <comp lib="9" loc="(5240,1630)" name="Text">
      <a name="font" val="SansSerif plain 14"/>
      <a name="halign" val="left"/>
      <a name="text" val="STOP_ENABLE: 1 = on, 0 = off."/>
    </comp>
    <comp lib="9" loc="(5240,1670)" name="Text">
